# Neon Postgres connection string (from your Neon dashboard)
DATABASE_URL=postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/dental_chic?sslmode=require

# Any long random string — used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string

# Port the API listens on locally (Render will set its own PORT automatically)
PORT=4000

# Allow requests from your deployed frontend. Use * only for local development.
CORS_ORIGIN=http://localhost:5173
